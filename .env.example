# Storage
DATABASE_URL=sqlite:///data/app.db

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# Embeddings: EMBEDDING_SIZE must match the Qdrant collection vector size.
# Changing either value requires re-indexing every document.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_SIZE=1024

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# LLM provider selection: 'openrouter' or 'ollama'
LLM_PROVIDER=openrouter

# OpenRouter (when using openrouter provider)
OPENROUTER_URL=https://api.openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-4o-mini
OPENROUTER_CONNECT_TIMEOUT=10.0
OPENROUTER_READ_TIMEOUT=120.0
OPENROUTER_SUPPORTS_STRUCTURED_OUTPUT=false
OPENROUTER_SUPPORTS_JSON_MODE=false
OPENROUTER_SUPPORTS_STREAMING=false
LLM_MAX_ATTEMPTS=2
LLM_TOTAL_TIMEOUT=180.0

# OCR: languages joined with '+' and installed in Tesseract
TESSERACT_LANGUAGES=kat+eng

# Ingestion tuning
CHUNK_MAX_LENGTH=1000
CHUNK_OVERLAP=100
MIN_TEXT_LENGTH=20
